{
  "manifest_version": 3,
  "name": "Golink over Tailscale",
  "version": "0.1.0",
  "key": "",
  "update_url": "https://github.com/rshade/golink_chrome_extension/releases/latest/download/update.xml",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "storage", "tabs", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://go/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "status.html"},
  "omnibox": {"keyword": "go"},
  "web_accessible_resources": [{"resources": ["status.html"], "matches": ["<all_urls>"]}],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}
}
